---
import '../styles/global.css';
import MotionController from '../components/MotionController';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Hi-Fi 行业研究、主观试听档案与摄影作品。',
} = Astro.props;

const navigation = [
  { href: '/', label: '首页' },
  { href: '/research/', label: '关于hifi市场个人的一些看法' },
  { href: '/listening/', label: '试听档案' },
  { href: '/photography/', label: '一些随手拍' },
  { href: '/about/', label: '关于' },
];
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <nav aria-label="主导航">
        <ul>
          {navigation.map((item) => (
            <li><a href={item.href} aria-current={pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <MotionController client:load />
  </body>
</html>
