---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import { isContentVisible } from '../../../lib/content-visibility';
import { formatDate } from '../../../lib/format-date';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('field-notes', ({ data }) => isContentVisible(data));
  return entries.map((entry) => ({ params: { id: entry.data.slug }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'field-notes'> }
const { entry } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.overallImpression}>
  <article>
    <header>
      <p>{entry.data.city} · {formatDate(entry.data.date)}</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.overallImpression}</p>
      <Image src={entry.data.cover} alt={entry.data.coverAlt} widths={[720, 1200, 1600]} sizes="(max-width: 48rem) 100vw, 72rem" />
    </header>
    <section aria-labelledby="photo-notes-heading">
      <h2 id="photo-notes-heading">现场照片与即时感受</h2>
      {entry.data.photoNotes.map((item) => (
        <figure>
          <Image src={item.image} alt={item.alt} widths={[720, 1200, 1600]} sizes="(max-width: 48rem) 100vw, 72rem" loading="lazy" />
          {item.note && <figcaption>{item.note}</figcaption>}
        </figure>
      ))}
    </section>
    {entry.data.featuredGear.length > 0 && (
      <section aria-labelledby="gear-heading">
        <h2 id="gear-heading">当天重点试听器材</h2>
        <ul>{entry.data.featuredGear.map((gear) => <li>{gear}</li>)}</ul>
      </section>
    )}
    {entry.data.observations.length > 0 && (
      <section aria-labelledby="observations-heading">
        <h2 id="observations-heading">现场观察</h2>
        <ul>{entry.data.observations.map((observation) => <li>{observation}</li>)}</ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  figure {
    margin: 2rem 0;
  }
  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
