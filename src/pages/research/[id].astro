---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { isContentVisible } from '../../lib/content-visibility';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format-date';

export async function getStaticPaths() {
  const entries = await getCollection('research', ({ data }) => isContentVisible(data));
  return entries.map((entry) => ({ params: { id: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'research'> };
const { Content } = await render(entry);
const topicLabels = {
  'market-competition': '市场与竞争',
  'product-user': '产品与用户',
  'channel-growth': '渠道与增长',
} as const;
const relatedEntries = (await getCollection('research', ({ data }) => isContentVisible(data)))
  .filter((candidate) => entry.data.relatedResearch.includes(candidate.data.slug))
  .sort((a, b) => entry.data.relatedResearch.indexOf(a.data.slug) - entry.data.relatedResearch.indexOf(b.data.slug));
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="research-article">
    <header data-reveal>
      {entry.data.preview && !entry.data.publish && <span class="preview-notice">本地预览稿 · 未正式发布</span>}
      <p class="eyebrow">{topicLabels[entry.data.topic]}</p>
      <h1>{entry.data.title}</h1>
      <p class="research-question"><strong>研究问题：</strong>{entry.data.researchQuestion}</p>
      <div class="research-meta">
        <span>研究时间：{entry.data.researchDate}</span>
        <span>整理更新：{formatDate(entry.data.updatedAt)}</span>
      </div>
    </header>

    <section aria-labelledby="conclusions-heading" data-reveal>
      <h2 id="conclusions-heading">三条核心结论</h2>
      <ol class="conclusion-list">{entry.data.conclusions.map((conclusion) => <li>{conclusion}</li>)}</ol>
    </section>

    <section aria-labelledby="analysis-heading">
      <h2 id="analysis-heading">完整论证</h2>
      <div class="article-body"><Content /></div>
    </section>

    <section aria-labelledby="sources-heading" data-reveal>
      <h2 id="sources-heading">来源与适用范围</h2>
      <div class="article-body">
      <p>{entry.data.scope}</p>
      <ul class="source-list">
        {entry.data.sources.map((source) => (
          <li>{source.url ? <a href={source.url} rel="noreferrer">{source.label}</a> : source.label}</li>
        ))}
      </ul>
      </div>
    </section>

    {relatedEntries.length > 0 && (
      <section aria-labelledby="related-heading" data-reveal>
        <h2 id="related-heading">继续阅读</h2>
        <ul class="related-list">
          {relatedEntries.map((related) => (
            <li><a href={`/research/${related.data.slug}/`}><span>{topicLabels[related.data.topic]}</span><strong>{related.data.title}</strong></a></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .related-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-list a {
    display: grid;
    min-height: 12rem;
    align-content: space-between;
    gap: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 1.5rem;
    background: var(--paper-bright);
    text-decoration: none;
    transition: transform 400ms ease, background 200ms ease;
  }

  .related-list a:hover {
    transform: translateY(-4px);
    background: #fff;
  }

  .related-list span {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .related-list strong {
    font-size: clamp(1.2rem, 2vw, 2rem);
    line-height: 1.1;
  }

  @media (max-width: 40rem) {
    .related-list {
      grid-template-columns: 1fr;
    }
  }
</style>
