---
import { getCollection } from 'astro:content';
import { isContentVisible } from '../../lib/content-visibility';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';

const [profile] = await getCollection('profile', ({ data }) => isContentVisible(data));
---

<BaseLayout title="关于">
  <header class="page-header" data-reveal>
    <h1>关于</h1>
  </header>
  {profile ? (
    <div class="about-sections">
      <section aria-labelledby="contact-heading">
        <h2 id="contact-heading">联系方式</h2>
        {profile.data.contacts.length > 0 ? (
          <ul>{profile.data.contacts.map((item) => <li>{item.href ? <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>{item.label}：{item.value}</a> : `${item.label}：${item.value}`}</li>)}</ul>
        ) : <EmptyState />}
      </section>
    </div>
  ) : <EmptyState title="个人资料尚未公开" />}
</BaseLayout>

<style>
  .about-sections {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 2rem;
    background: var(--line);
  }

  .about-sections section {
    display: grid;
    grid-template-columns: minmax(12rem, 0.6fr) minmax(0, 1fr);
    gap: 3rem;
    padding: clamp(1.5rem, 5vw, 4rem);
    background: var(--paper-bright);
  }

  .about-sections h2,
  .about-sections p {
    margin-top: 0;
  }

  @media (max-width: 48rem) {
    .about-sections section {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
