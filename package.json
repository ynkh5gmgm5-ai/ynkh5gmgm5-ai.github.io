{
  "name": "hifi-personal-brand-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "content:sync": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro sync",
    "sync:obsidian": "tsx scripts/sync-obsidian/index.ts",
    "setup:obsidian-publication": "tsx scripts/sync-obsidian/setup-publication.ts",
    "curate:research": "tsx scripts/sync-obsidian/curate-research.ts",
    "validate:obsidian": "tsx scripts/sync-obsidian/index.ts --dry-run --production",
    "test:sync": "tsx --test tests/sync-obsidian.test.ts",
    "test:ui": "playwright test tests/site.spec.ts --reporter=line"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/react": "6.0.4",
    "@gsap/react": "2.1.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.8",
    "echarts": "6.1.0",
    "gray-matter": "4.0.3",
    "gsap": "3.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/mdast": "4.0.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "cross-env": "10.1.0",
    "lighthouse": "13.4.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.6.0"
}
